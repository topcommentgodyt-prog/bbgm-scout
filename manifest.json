{
  "manifest_version": 3,
  "name": "Courtside",
  "version": "2.7.1",
  "description": "The all-in-one GM toolkit for Basketball GM: scouting, OVR predictions, trades, contracts, draft, team management and Autopilot.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Courtside",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://play.basketball-gm.com/*",
        "https://beta.basketball-gm.com/*"
      ],
      "js": [
        "src/bridge-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://play.basketball-gm.com/*",
        "https://beta.basketball-gm.com/*"
      ],
      "js": [
        "src/engine.js",
        "src/strategy.js",
        "src/data.js",
        "src/storage.js",
        "src/analyze.js",
        "src/bridge.js",
        "src/league.js",
        "src/features.js",
        "src/realism.js",
        "src/planning.js",
        "src/moneyball.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
